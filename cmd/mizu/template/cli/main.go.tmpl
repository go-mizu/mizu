// Command {{.Name}} is a command line tool.
package main

import (
	"context"
	"os"
	"runtime"
	"runtime/debug"
	"strings"

	"github.com/go-mizu/mizu/console"
)

func main() {
	os.Exit(newApp().Main(os.Args[1:]))
}

// newApp builds the command line.
//
// It is a function rather than a package variable so that a test gets a fresh
// one. A command holds what its flags parsed into, so an app that has run once
// is an app whose commands are already filled in.
func newApp() *console.App {
	app := &console.App{
		Name:    "{{.Name}}",
		Desc:    "What this tool does, in one line",
		Version: buildVersion(),
	}
	app.Add(&Greet{}, &Version{})
	return app
}

// buildVersion is what this binary was built from.
//
// It comes out of the table the compiler already embeds, so there are no
// -ldflags to remember and nothing to keep in step: a binary from go install
// carries the module version it was installed at, and one built from a
// checkout carries "(devel)".
func buildVersion() string {
	info, ok := debug.ReadBuildInfo()
	if !ok || info.Main.Version == "" {
		return "unknown"
	}
	return info.Main.Version
}

// Greet is one command.
//
// Every command is a struct with a Spec and a Run. The fields are where its
// flags and arguments parse into, which is why Run takes no arguments beyond
// the context and the streams.
type Greet struct {
	Name string
	Loud bool
}

func (c *Greet) Spec() console.Spec {
	return console.Spec{
		Name: "greet",
		Desc: "Say hello to somebody",
		Flags: []console.Flag{
			{Name: "loud", Short: 'l', Desc: "Shout it", Value: console.Bool(&c.Loud)},
		},
		Args: []console.Arg{
			{Name: "name", Desc: "Who to greet", Default: "world", Value: console.String(&c.Name)},
		},
	}
}

// Run does the work.
//
// The answer goes to stdout through IO, not to os.Stdout, which is what lets a
// test read it. Anything the tool says about itself goes to stderr, so that
// piping the output somewhere gives the answer on its own.
func (c *Greet) Run(ctx context.Context, io *console.IO) error {
	hello := "Hello, " + c.Name + "!"
	if c.Loud {
		hello = strings.ToUpper(hello)
	}
	io.Line(hello)
	return nil
}

// Version is the first thing anybody types at a binary they did not build, and
// the answer a bug report is worth nothing without.
//
// The JSON form is there because --json is a global flag, so every command
// takes it whether or not it does anything with it, and one that takes it and
// then prints a line for a person is one a script cannot read.
type Version struct{}

func (c *Version) Spec() console.Spec {
	return console.Spec{
		Name: "version",
		Desc: "Print what this was built from",
	}
}

func (c *Version) Run(ctx context.Context, io *console.IO) error {
	if io.JSONMode() {
		return io.JSON(map[string]string{
			"version": buildVersion(),
			"go":      runtime.Version(),
			"os":      runtime.GOOS,
			"arch":    runtime.GOARCH,
		})
	}
	io.Print("{{.Name}} %s %s %s/%s\n", buildVersion(), runtime.Version(), runtime.GOOS, runtime.GOARCH)
	return nil
}
