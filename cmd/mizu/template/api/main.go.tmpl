// Command {{.Name}} is an HTTP service.
package main

import (
	"fmt"
	"log"
	"net/http"
	"os"
	"runtime/debug"

	"github.com/go-mizu/mizu"
)

// name is what this service calls itself, on the command line and at the root.
const name = "{{.Name}}"

func main() {
	// A service that ignores its arguments is one where --help opens a port.
	// There are two things anybody types at a binary they did not build, and
	// neither of them should start listening.
	if len(os.Args) > 1 {
		switch os.Args[1] {
		case "version", "--version":
			fmt.Printf("%s %s\n", name, buildVersion())
		case "help", "-h", "--help":
			fmt.Printf("usage: %s\n\nServes HTTP on $ADDR, or on :8080.\n", name)
		default:
			fmt.Fprintf(os.Stderr, "%s takes no arguments, and there is help and version\n", name)
			os.Exit(2)
		}
		return
	}

	addr := os.Getenv("ADDR")
	if addr == "" {
		addr = ":8080"
	}
	log.Printf("listening on %s", addr)
	if err := newApp().Listen(addr); err != nil {
		log.Fatal(err)
	}
}

// buildVersion is what this binary was built from.
//
// It comes out of the table the compiler already embeds, so there are no
// -ldflags to remember and nothing to keep in step: a binary from go install
// carries the module version it was installed at, and one built from a
// checkout carries "(devel)".
func buildVersion() string {
	info, ok := debug.ReadBuildInfo()
	if !ok || info.Main.Version == "" {
		return "unknown"
	}
	return info.Main.Version
}

// newApp builds the routes.
//
// They live here rather than in main so that a test gets the same application
// the binary serves, with no socket to open and no port to pick.
func newApp() *mizu.App {
	app := mizu.New()
	// The {$} is what makes this the root and nothing else. A pattern ending
	// in a slash matches everything under it, so a plain "/" here would answer
	// every request that no other route claimed.
	app.Get("/{$}", index)
	app.Get("/hello/{name}", hello)
	app.Get("/livez", livez)
	return app
}

// index says what this service is, which is the one thing somebody who has
// found the root of an unfamiliar service wants to know.
func index(c *mizu.Ctx) error {
	return c.JSON(http.StatusOK, map[string]string{"service": name, "version": buildVersion()})
}

func hello(c *mizu.Ctx) error {
	return c.JSON(http.StatusOK, map[string]string{"hello": c.Param("name")})
}

// livez answers while the process is still serving, which is what a load
// balancer and an orchestrator want to know. It says nothing about whether
// what this service depends on is up: that is a readiness check, and it goes
// in once there is something to be ready for.
func livez(c *mizu.Ctx) error {
	return c.Text(http.StatusOK, "ok")
}
